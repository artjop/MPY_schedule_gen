# Environment variables for the schedule service

# Secret token for protecting internal endpoints
# Change this to a random secure value in production!
SECRET_TOKEN=change_this_secret_token

# Database URL (SQLite by default)
# For SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/schedule.db

# For PostgreSQL (uncomment and modify):
# DATABASE_URL=postgresql+asyncpg://schedule_user:password@localhost:5432/schedule

# Cooldown period between manual refreshes (in seconds)
REFRESH_COOLDOWN_SECONDS=300

# PostgreSQL settings (if using PostgreSQL)
# POSTGRES_DB=schedule
# POSTGRES_USER=schedule_user
# POSTGRES_PASSWORD=changeme
